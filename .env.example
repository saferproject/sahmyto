NEXT_PUBLIC_API_URL=https://api.example.com/
NEXT_PUBLIC_IMAGE_ASSETS_URL=https://api.example.com/

# Optional Reverb connection. Copy server values into .env.development.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Optional production telemetry. When unset, structured events are logged.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=
NEXT_PUBLIC_APP_VERSION=
